# Biome art masters — ~2.8 MB PNGs kept locally as the source for the picture
# work on the biome-pictures branch. Nothing on main serves them.
img/biomes/src/

# Environment backdrop masters — the PNG renders that img/env/<id>.jpg is
# encoded from. The site serves the JPEG at the master's own pixel width: the
# blur behind a card is only 2px, so there is nothing to hide an upscale behind.
img/env/src/

# Header mark master — the 2 MB transparent render that img/brand-logo.png is
# cropped and downscaled from. Kept locally in case the mark is ever needed
# larger; the site only ever serves the 206x168 copy.
img/logo_tr.png

# Claude Code's per-machine config: launch.json (this checkout's local dev-server
# setup) and settings.local.json (locally granted tool permissions) describe this
# machine, not the project. .claude/plans/ is scratch working documents for a
# change in progress, not project documentation (see planning.md). Everything
# else under .claude/ — rules/, skills/ — is shared project configuration and
# is tracked.
.claude/launch.json
.claude/settings.local.json
.claude/plans/

# Build output of scripts/build.js — .github/workflows/deploy.yml generates
# this fresh on every deploy; it's never meant to be committed.
dist/

# Dev-only tooling (package.json's devDependencies, currently just `sharp`
# for scripts/generate-adversary-art.js) — never loaded by the runtime site
# itself, reinstalled locally with `npm install` as needed.
node_modules/

# Review screenshots from scripts/battle-points-screenshots.js — kept local:
# scripts/build.js copies every top-level directory, so tracked screenshots
# would be published in dist/.
artifacts/
